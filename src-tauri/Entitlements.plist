<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri signs bundled macOS builds with the hardened runtime, even ad-hoc
       ones, and the hardened runtime blocks the microphone unless the app has
       this entitlement. Voice input needs it. `tauri dev` is not signed this
       way, so a missing entitlement only shows up in bundled builds. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
